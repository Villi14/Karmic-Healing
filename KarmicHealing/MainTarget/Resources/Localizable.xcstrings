          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "空間を整える"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "공간을 준비하세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przygotuj swoją przestrzeń"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
