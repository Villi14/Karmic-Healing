    "help_step_1_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এমন একটি শান্ত জায়গা বেছে নিন যেখানে কেউ আপনাকে বিরক্ত করবে না। আরাম করে বসুন বা শুয়ে পড়ুন, চোখ বন্ধ করুন এবং শিথিল হতে কয়েকবার গভীর শ্বাস নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suche dir einen ruhigen Ort, an dem dich niemand stört. Setz oder leg dich bequem hin, schließe die Augen und atme mehrmals tief durch, um zur Ruhe zu kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find a quiet place where you won't be disturbed. Sit or lie down comfortably, close your eyes, and take several deep breaths to relax."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Busca un lugar tranquilo donde nadie te moleste. Siéntate o recuéstate cómodamente, cierra los ojos y respira hondo varias veces para relajarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trouvez un endroit calme où personne ne vous dérangera. Asseyez-vous ou allongez-vous confortablement, fermez les yeux et prenez plusieurs respirations profondes pour vous détendre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐसा शांत स्थान खोजें जहाँ कोई आपको बाधित न करे। आराम से बैठें या लेटें, आँखें बंद करें और शिथिल होने के लिए कुछ गहरी साँसें लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trova un luogo tranquillo dove nessuno possa disturbarti. Siediti o sdraiati comodamente, chiudi gli occhi e fai diversi respiri profondi per rilassarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "誰にも邪魔されない静かな場所を見つけます。楽な姿勢で座るか横になり、目を閉じて、深呼吸を数回してリラックスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "방해받지 않을 조용한 장소를 찾으세요. 편안히 앉거나 누워 눈을 감고, 깊은 호흡을 몇 번 하며 긴장을 풀어 줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Znajdź spokojne miejsce, w którym nikt Ci nie przeszkodzi. Usiądź lub połóż się wygodnie, zamknij oczy i weź kilka głębokich oddechów, aby się zrelaksować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encontre um lugar tranquilo onde você não será perturbado. Sente-se ou deite-se confortavelmente, feche os olhos e respire fundo algumas vezes para relaxar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите тихое место, где вас никто не потревожит. Сядьте или лягте удобно, закройте глаза и сделайте несколько глубоких вдохов для расслабления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rahatsız edilmeyeceğin sakin bir yer bul. Rahatça otur ya da uzan, gözlerini kapat ve gevşemek için birkaç derin nefes al."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайдіть тихе місце, де вас ніхто не потурбує. Сядьте або ляжте зручно, закрийте очі та зробіть кілька глибоких вдихів для розслаблення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "找一个不会被打扰的安静地方。舒适地坐着或躺下，闭上眼睛，做几次深呼吸让自己放松。"
          }
        }
      }
    },
    "help_step_1_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার পরিসর প্রস্তুত করুন"
          }
        },
        "de" : {
          "stringUnit" : {
