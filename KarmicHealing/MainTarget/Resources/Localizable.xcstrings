    "help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
