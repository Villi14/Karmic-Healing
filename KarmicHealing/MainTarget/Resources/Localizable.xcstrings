      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your reminders, requests, notes, and preferences are stored locally in the app’s storage on your Apple device. The app does not provide cloud sync. Depending on your iOS backup settings, app data may be included in a device backup. Any backup or restore service is governed by the policies and settings of Apple or the service you choose."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши напоминания, просьбы, заметки и настройки хранятся локально в хранилище приложения на вашем устройстве Apple. В приложении нет синхронизации с облаком. В зависимости от настроек резервного копирования iOS данные приложения могут попасть в резервную копию устройства. Любое резервное копирование или восстановление регулируется политиками и настройками Apple или выбранного вами сервиса."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші нагадування, прохання, нотатки та налаштування зберігаються локально у сховищі застосунку на вашому пристрої Apple. Застосунок не має синхронізації з хмарою. Залежно від налаштувань резервного копіювання iOS, дані застосунку можуть потрапити до резервної копії пристрою. Будь-яке резервне копіювання або відновлення регулюється політиками та налаштуваннями Apple або обраного вами сервісу."
          }
        }
      }
    },
    "privacy_policy_storage_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Storage"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранение данных"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігання даних"
          }
        }
      }
    },
    "privacy_policy_third_party_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app contains no third-party analytics, advertising, tracking pixels, cookies, or data-collection SDKs. It does use open-source software libraries to provide app functionality. If you choose to open an external website or contact us by email, that interaction is handled by the relevant website, App Store, or email provider under its own privacy policy. The app does not send your stored app data along with those actions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не содержит сторонней аналитики, рекламы, пикселей отслеживания, файлов cookie или SDK для сбора данных. Оно использует библиотеки с открытым исходным кодом для работы функций. Если вы откроете внешний веб-сайт или свяжетесь с нами по электронной почте, соответствующее взаимодействие обрабатывается этим сайтом, App Store или почтовым провайдером в соответствии с их собственной политикой конфиденциальности. Приложение не отправляет вместе с этими действиями сохраненные данные приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок не містить сторонньої аналітики, реклами, пікселів відстеження, файлів cookie або SDK для збору даних. Він використовує бібліотеки з відкритим кодом для роботи функцій. Якщо ви відкриєте зовнішній вебсайт або зв’яжетеся з нами електронною поштою, відповідна взаємодія обробляється цим вебсайтом, App Store або поштовим провайдером відповідно до їхньої власної політики конфіденційності. Застосунок не надсилає разом із цими діями збережені дані застосунку."
          }
        }
      }
    },
