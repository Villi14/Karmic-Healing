    "help_tip_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নিয়মিত সাধনা করুন — যত বেশি যোগাযোগ করবেন, সংযোগ তত দৃঢ় হবে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Übe regelmäßig – je öfter du Verbindung aufnimmst, desto stärker wird sie"
          }
