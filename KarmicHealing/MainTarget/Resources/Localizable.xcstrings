    "privacy_policy_intro_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing iPhone, iPad ও Apple Watch-এ চলে এবং অফলাইনে কাজ করার জন্যই তৈরি। আপনার ব্যক্তিগত তথ্য সংগ্রহ, সংরক্ষণ বা প্রক্রিয়াকরণ করে এমন কোনো সার্ভার আমরা চালাই না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing läuft auf iPhone, iPad und Apple Watch und ist für die Nutzung ohne Internetverbindung ausgelegt. Wir betreiben keine Server, die deine personenbezogenen Daten erheben, speichern oder verarbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmic Healing works on iPhone, iPad, and Apple Watch and is designed to work offline. We do not operate servers that collect, store, or process your personal information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing funciona en iPhone, iPad y Apple Watch y está diseñada para funcionar sin conexión. No operamos servidores que recopilen, almacenen o procesen tu información personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing fonctionne sur iPhone, iPad et Apple Watch et est conçue pour fonctionner hors ligne. Nous n'exploitons aucun serveur qui collecte, stocke ou traite vos informations personnelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing iPhone, iPad और Apple Watch पर चलता है और ऑफ़लाइन काम करने के लिए बनाया गया है। हम ऐसे कोई सर्वर नहीं चलाते जो आपकी व्यक्तिगत जानकारी एकत्र, संग्रहीत या संसाधित करते हों।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing funziona su iPhone, iPad e Apple Watch ed è progettata per funzionare offline. Non gestiamo server che raccolgono, conservano o elaborano i tuoi dati personali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing は iPhone、iPad、Apple Watch で動作し、オフラインで使えるように設計されています。当方は、お客様の個人情報を収集・保存・処理するサーバーを運用していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing은 iPhone, iPad, Apple Watch에서 작동하며 오프라인 사용을 전제로 설계되었습니다. 저희는 사용자의 개인정보를 수집·저장·처리하는 서버를 운영하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing działa na iPhonie, iPadzie i Apple Watch i jest zaprojektowana do pracy offline. Nie prowadzimy serwerów, które zbierają, przechowują lub przetwarzają Twoje dane osobowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Karmic Healing funciona no iPhone, no iPad e no Apple Watch e foi feito para funcionar off-line. Não operamos servidores que coletem, armazenem ou processem suas informações pessoais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmic Healing работает на iPhone, iPad и Apple Watch и предназначено для работы в автономном режиме. Мы не управляем серверами, которые собирают, хранят или обрабатывают вашу личную информацию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing iPhone, iPad ve Apple Watch üzerinde çalışır ve çevrimdışı kullanılmak üzere tasarlanmıştır. Kişisel bilgilerini toplayan, saklayan veya işleyen sunucular işletmiyoruz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmic Healing працює на iPhone, iPad і Apple Watch та розроблений для роботи офлайн. Ми не керуємо серверами, які збирають, зберігають або обробляють вашу особисту інформацію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karmic Healing 可在 iPhone、iPad 和 Apple Watch 上使用，并按离线使用设计。我们不运营任何收集、存储或处理你个人信息的服务器。"
          }
        }
      }
    },
