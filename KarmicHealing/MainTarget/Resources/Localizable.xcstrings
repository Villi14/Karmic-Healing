    "requests_empty_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি যা চাইছেন তা লিখে রাখুন। এখনই পূর্ণ না হতে পারলে সেটিকে উপ-প্রার্থনায় ভাগ করে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schreibe auf, worum du bittest. Lässt es sich nicht sofort erfüllen, teile es in Teilbitten auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down what you are asking for. If it cannot be fulfilled right away, break it into subrequests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escribe lo que estás pidiendo. Si no puede cumplirse de inmediato, divídelo en subpeticiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notez ce que vous demandez. Si cela ne peut pas être accompli tout de suite, divisez-le en sous-demandes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप जो माँग रहे हैं उसे लिखें। यदि वह तुरंत पूरी न हो सके, तो उसे उप-प्रार्थनाओं में बाँट दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scrivi ciò che stai chiedendo. Se non può essere esaudito subito, suddividilo in sottorichieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "願っていることを書き留めましょう。すぐに叶えられない場合は、小さな願いに分けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "무엇을 청하는지 적어 보세요. 바로 이루어질 수 없다면 하위 청원으로 나누세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapisz, o co prosisz. Jeśli nie da się tego spełnić od razu, podziel to na podprośby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escreva o que você está pedindo. Se não puder ser atendido de imediato, divida em subpedidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите, о чём вы просите. Если это нельзя выполнить прямо сейчас, разбейте просьбу на подпросьбы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne dilediğini yaz. Hemen yerine gelemeyecekse alt dileklere böl."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишіть, про що ви просите. Якщо це не можна виконати прямо зараз, розбийте прохання на підпрохання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "写下你所祈请的事。如果无法立刻实现，就把它拆分为子祈请。"
          }
        }
      }
    },
