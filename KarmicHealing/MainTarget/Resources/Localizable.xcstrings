    "step_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask permission to speak with the Lords of Karma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите разрешения поговорить с Властителями Кармы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запитайте дозвіл говорити з Володарями Карми."
          }
        }
      }
    },
    "step_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask them to align your energy bodies and set up contacts between them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите их выстроить ваши энергетические тела и настроить контакты между\nними"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть їх вирівняти ваші енергетичні тіла та налаштувати контакти між ними."
          }
        }
      }
    },
    "step_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask to clear, heal, activate and open:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите очистить, исцелить, активировать и открыть:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть очистити, зцілити, активувати та відкрити:"
          }
        }
      }
    },
    "step_3_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a) Ka Matrix;\nb) Etheric Matrix;\nc) Ketheric Matrix;\nd) Celestial Matrix;\nd) I-Am Matrix.\n\nDo this in order. Move on to the next request, having finished with the previous one."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) Матрицу Ка;\nb) Эфирную Матрицу;\nc) Кетерическую Матрицу;\nd) Небесную Матрицу;\nd) Матрицу Я-Есть.\n\nСделайте это по порядку. Переходите к следующей просьбе, закончив с предыдущей."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) Матрицю Ка;\nb) Ефірну Матрицю;\nc) Кетеричну Матрицю;\nd) Небесну Матрицю;\nd) Матрицю Я-Є.\n\nЗробіть це в порядку. Переходьте до наступного прохання, завершивши попереднє."
          }
        }
      }
    },
    "step_last" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Return to today, but continue to lie down for at least two hours."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращайтесь в сегодняшний день, но продолжайте лежать не менее двух часов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертайтеся в сьогоднішній день, але продовжуйте лежати не менше двох годин."
          }
        }
      }
    },
