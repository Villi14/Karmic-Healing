    "part_1_step_6_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কর্মের অধিপতিগণের কাছে প্রার্থনা করুন যেন তাঁরা কুণ্ডলিনী চক্রগুলিকে সমস্ত নেতিবাচক সংযোগ থেকে শুদ্ধ, মুক্ত ও নিরাময় করেন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitte die Herren des Karma, die Kundalini-Chakren von allen negativen Verbindungen zu reinigen, zu befreien und zu heilen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the Lords of Karma to cleanse, release, and heal the Kundalini chakras from all negative connections"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pide a los Señores del Karma que limpien, liberen y sanen los chakras de la Kundalini de todas las conexiones negativas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demandez aux Seigneurs du Karma de nettoyer, libérer et guérir les chakras de la Kundalini de tous les liens négatifs"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कर्म के स्वामियों से प्रार्थना करें कि वे कुंडलिनी चक्रों को सभी नकारात्मक संबंधों से शुद्ध करें, मुक्त करें और उनका उपचार करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiedi ai Signori del Karma di purificare, liberare e guarire i chakra della Kundalini da tutti i legami negativi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クンダリーニのチャクラを、あらゆる否定的なつながりから浄化し、解放し、癒やすようカルマの主たちに願い出ます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "쿤달리니 차크라를 모든 부정적인 연결에서 정화하고 풀어 주며 치유해 달라고 카르마의 주인들에게 청하세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poproś Władców Karmy o oczyszczenie, uwolnienie i uzdrowienie czakr Kundalini ze wszystkich negatywnych połączeń"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peça aos Senhores do Karma que limpem, liberem e curem os chakras da Kundalini de todas as conexões negativas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите Властителей Кармы очистить, освободить и исцелить чакры Кундалини от всяких негативных связей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karma Efendileri'nden Kundalini çakralarını tüm olumsuz bağlantılardan arındırmasını, özgürleştirmesini ve iyileştirmesini iste"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть Володарів Карми очистити, звільнити та зцілити чакри Кундаліні від усіх негативних зв’язків."
