        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratique com regularidade — quanto mais você se comunica, mais forte fica sua conexão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практикуйтесь регулярно - чем больше вы общаетесь, тем сильнее становится ваша связь"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Düzenli pratik yap — ne kadar çok iletişim kurarsan bağın o kadar güçlenir"
