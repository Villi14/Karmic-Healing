    "part_1_step_10_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ক) তাঁর নাম জিজ্ঞাসা করুন;\nখ) তাঁর কাছে একটি উপহার চান;\nগ) বিনিময়ে তিনি কী উপহার চান তা শুনুন;\nঘ) তাঁকে চিরকাল আপনার সঙ্গে থাকতে বলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) frage nach seinem Namen;\nb) bitte es um ein Geschenk;\nc) höre, worum es dich als Gegengeschenk bittet;\nd) bitte es, für immer bei dir zu bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a) ask his name;\nb) ask him for a gift;\nc) listen to his request for a return gift;\nd) ask that it remain with you always."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) pregúntale su nombre;\nb) pídele un regalo;\nc) escucha su petición de un regalo a cambio;\nd) pídele que permanezca contigo siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) demandez-lui son nom ;\nb) demandez-lui un cadeau ;\nc) écoutez le cadeau qu'il demande en retour ;\nd) demandez-lui de rester toujours avec vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क) उसका नाम पूछें;\nख) उससे एक उपहार माँगें;\nग) बदले में वह जो उपहार चाहता है, उसे सुनें;\nघ) प्रार्थना करें कि वह सदा आपके साथ रहे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) chiedigli il suo nome;\nb) chiedigli un dono;\nc) ascolta il dono che ti chiede in cambio;\nd) chiedigli di restare con te per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) 名前を尋ねます；\nb) 贈り物を求めます；\nc) 返礼として何を望むかを聴きます；\nd) いつもそばにいてくれるよう頼みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가) 이름을 물으세요;\n나) 선물을 청하세요;\n다) 답례로 무엇을 원하는지 들으세요;\n라) 언제나 함께 있어 달라고 청하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) zapytaj o jej imię;\nb) poproś ją o dar;\nc) wysłuchaj, o jaki dar prosi w zamian;\nd) poproś, aby została z Tobą na zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) pergunte o nome dele;\nb) peça um presente a ele;\nc) escute o pedido dele de um presente em troca;\nd) peça que ele permaneça sempre com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) спросите его имя;\nb) попросите его о даре;\nc) выслушайте его просьбу об ответном даре;\nd) попросите, чтобы оно оставалось с вами всегда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) adını sor;\nb) ondan bir armağan iste;\nc) karşılık olarak istediği armağanı dinle;\nd) her zaman seninle kalmasını iste."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) запитайте його ім'я;\nb) попросіть його про дар;\nc) вислухайте його прохання про відповідний дар;\nd) попросіть, щоб це залишалося з вами завжди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "a) 询问他的名字；\nb) 向他请求一份礼物；\nc) 聆听他所请求的回礼；\nd) 请他永远与你同在。"
          }
        }
      }
    },
    "part_1_step_11" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার উচ্চতর সত্তাকে বলুন হারা রেখার পথ ও চক্রগুলি শুদ্ধ করতে, সারিবদ্ধ করতে, খুলে দিতে, সক্রিয় করতে ও পূর্ণ করতে।"
