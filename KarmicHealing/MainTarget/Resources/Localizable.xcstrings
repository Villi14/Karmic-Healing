    "privacy_policy_data_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does not require an account and does not send your reminders, requests, notes, or app activity to us. Information you enter is kept on your device for the app to function. We do not use analytics, advertising identifiers, or usage-tracking services."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению не требуется учетная запись, и оно не отправляет нам ваши напоминания, просьбы, заметки или данные об использовании. Введенная вами информация хранится на вашем устройстве для работы приложения. Мы не используем аналитику, рекламные идентификаторы или сервисы отслеживания использования."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок не потребує облікового запису та не надсилає нам ваші нагадування, прохання, нотатки чи дані про використання. Введена вами інформація зберігається на пристрої, щоб застосунок міг працювати. Ми не використовуємо аналітику, рекламні ідентифікатори або сервіси відстеження використання."
          }
        }
      }
    },
    "privacy_policy_data_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
