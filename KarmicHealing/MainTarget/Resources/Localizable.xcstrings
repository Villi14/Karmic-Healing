    "help_tip_initial_process" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রাথমিক প্রক্রিয়াটি কেবল একবারই করুন। শক্তির ভারসাম্যের অন্য সাধনাগুলি যখনই প্রয়োজন মনে হয়, তখনই করতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den Anfangsprozess führst du nur einmal durch. Die übrigen Übungen zum Energieausgleich kannst du machen, wann immer du sie brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete the Initial Process only once. Perform the other energy balancing practices whenever you feel they are needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El proceso inicial se realiza una sola vez. Las demás prácticas de equilibrio energético puedes hacerlas siempre que sientas que las necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le processus initial ne se fait qu'une seule fois. Les autres pratiques d'équilibrage énergétique peuvent être faites chaque fois que vous en ressentez le besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रारंभिक प्रक्रिया केवल एक बार पूरी करें। ऊर्जा संतुलन के अन्य अभ्यास तब करें जब भी आपको उनकी आवश्यकता लगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il processo iniziale si svolge una sola volta. Le altre pratiche di riequilibrio energetico puoi farle ogni volta che ne senti il bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "初期プロセスは一度だけ行います。ほかのエネルギー調整の実践は、必要だと感じたときにいつでも行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "초기 과정은 한 번만 진행합니다. 다른 에너지 조율 수행은 필요하다고 느낄 때마다 하시면 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proces początkowy wykonuje się tylko raz. Pozostałe praktyki równoważenia energii wykonuj wtedy, kiedy czujesz, że są potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O processo inicial é feito apenas uma vez. As demais práticas de equilíbrio energético podem ser feitas sempre que você sentir necessidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проходите Начальный процесс только один раз. Остальные практики балансировки энергии выполняйте по мере необходимости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Başlangıç sürecini yalnızca bir kez uygula. Diğer enerji dengeleme pratiklerini ise ihtiyaç duyduğunu hissettiğin her zaman yapabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Початковий процес проходьте лише один раз. Інші практики балансування енергії виконуйте за потреби."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "初始过程只需完成一次。其他能量平衡练习可在你觉得需要时随时进行。"
          }
        }
      }
