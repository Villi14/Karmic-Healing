    "help_step_5_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank the Lords of Karma for their time and assistance. Express your gratitude sincerely, regardless of whether you received immediate help or not."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поблагодарите Властителей Кармы за их время и помощь. Выразите свою благодарность искренне, независимо от того, получили ли вы немедленную помощь или нет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подякуйте Володарям Карми за їх час та допомогу. Висловіть свою подяку щиро, незалежно від того, чи отримали ви негайну допомогу чи ні."
          }
        }
      }
    },
