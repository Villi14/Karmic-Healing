            "value" : "허락을 구하세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poproś o pozwolenie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
