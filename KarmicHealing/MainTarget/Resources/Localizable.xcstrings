    "karma_liberation_prayer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই নিরাময় সমস্ত স্তর ও সমস্ত দেহ পেরিয়ে যাক, আমার সমস্ত জীবন পেরিয়ে যাক — এই বর্তমান জীবনসহ; (সম্পর্ক বা পরিস্থিতির কারণে হওয়া) সমস্ত ক্ষতি দূর হোক, আর নিরাময় আজকের দিনে — এই মুহূর্তে — এসে পৌঁছাক!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Möge diese Heilung durch alle Ebenen und alle Körper gehen, durch alle meine Leben, einschließlich dieses gegenwärtigen Lebens; möge aller Schaden (durch Verbindungen oder Situationen verursacht) aufgehoben werden, und möge die Heilung im Heute ankommen – im JETZT!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let this healing pass through all levels and all bodies, through all my lives, including this present life, let all harm (caused by connections or situations) be removed, and let healing come to today - to NOW!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Que esta sanación atraviese todos los niveles y todos los cuerpos, todas mis vidas, incluida esta vida presente; que se retire todo daño (causado por vínculos o situaciones) y que la sanación llegue al día de hoy, ¡al AHORA!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Que cette guérison traverse tous les niveaux et tous les corps, toutes mes vies, y compris cette vie présente ; que tout préjudice (causé par des liens ou des situations) soit retiré, et que la guérison arrive jusqu'à aujourd'hui — jusqu'à MAINTENANT !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह उपचार सभी स्तरों और सभी शरीरों से होकर गुज़रे, मेरे सभी जीवनों से — इस वर्तमान जीवन सहित; (संबंधों या परिस्थितियों से हुई) हर हानि दूर हो जाए, और उपचार आज तक — इस क्षण तक — पहुँचे!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Che questa guarigione attraversi tutti i livelli e tutti i corpi, tutte le mie vite, compresa questa vita presente; che ogni danno (causato da legami o situazioni) sia rimosso e che la guarigione giunga a oggi, all'ORA!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この癒やしが、すべての層とすべての体を通り抜け、この現在の人生を含むわたしのすべての人生を通り抜けますように。（つながりや状況によって生じた）あらゆる害が取り除かれ、癒やしが今日へ——「いま」へと届きますように！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 치유가 모든 층과 모든 몸을 지나, 지금의 삶을 포함한 나의 모든 생을 지나가게 하소서. (인연이나 상황으로 인한) 모든 해로움이 걷히고, 치유가 오늘에 — 지금 이 순간에 이르게 하소서!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Niech to uzdrowienie przejdzie przez wszystkie poziomy i wszystkie ciała, przez wszystkie moje życia, włącznie z tym obecnym życiem; niech zostanie zdjęta wszelka szkoda (spowodowana więziami lub sytuacjami) i niech uzdrowienie przyjdzie do dziś — do TERAZ!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Que esta cura atravesse todos os níveis e todos os corpos, todas as minhas vidas, incluindo esta vida presente; que todo dano (causado por vínculos ou situações) seja removido, e que a cura chegue ao dia de hoje — ao AGORA!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть это исцеление пройдет сквозь все уровни и все тела, через все мои жизни, в том числе и нынешнюю жизнь, пусть снимется всякий вред (принесенный связями или ситуациями), и пусть исцеление придет в сегодня - в СЕЙЧАС!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu şifa tüm düzeylerden ve tüm bedenlerden, bu şimdiki yaşam da dahil olmak üzere tüm yaşamlarımdan geçsin; (bağlar ya da durumlar nedeniyle oluşan) her türlü zarar kalksın ve şifa bugüne — ŞİMDİ'ye gelsin!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нехай це зцілення пройде крізь усі рівні та всі тіла, через всі мої життя, включаючи це теперішнє життя, нехай зніметься всяка шкода (завдана зв'язками чи ситуаціями), і нехай зцілення прийде в сьогодні - в ЗАРАЗ!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "愿这份疗愈穿越一切层面与一切身体，穿越我的所有生世，包括此生；愿一切伤害（由连结或情境所造成）被解除，愿疗愈来到今天——来到当下！"
          }
        }
      }
    },
    "karma_step_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কর্মের অধিপতিগণের সঙ্গে কথা বলার অনুমতি চান — আপনি তাঁদের উপস্থিতি অনুভব করবেন।"
          }
        },
        "de" : {
