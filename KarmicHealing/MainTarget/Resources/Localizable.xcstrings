    "screen_rest_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ধাপগুলির মাঝে পর্দা নিভে আসে এবং পরের ধাপে আবার জ্বলে ওঠে।"
