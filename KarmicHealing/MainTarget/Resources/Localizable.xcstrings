        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ta aplikacja jest uzupełnieniem rosyjskiego wydania „Karmic Healing”, które jest tłumaczeniem angielskiego wydania „Psychic Healing with Spirit Guides and Angels” Diany Stein."
