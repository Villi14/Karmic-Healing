        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "তাঁদের বলুন আপনার শক্তিদেহগুলি সারিবদ্ধ করতে এবং সেগুলির মধ্যে সংযোগ স্থাপন করতে।"
