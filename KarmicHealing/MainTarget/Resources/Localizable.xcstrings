    "part_1_step_10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask your Higher Self to come to you, and then:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите свое Высшее Я прийти к вам, а затем:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть своє Вище Я прийти до вас, а потім:"
          }
        }
      }
    },
    "part_1_step_10_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a) ask his name;\nb) ask him for a gift;\nc) listen to his request for a return gift;\nd) ask that it remain with you always."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) спросите его имя;\nb) попросите его о даре;\nc) выслушайте его просьбу об ответном даре;\nd) попросите, чтобы оно оставалось с вами всегда."
          }
        },
        "uk" : {
          "stringUnit" : {
