    "privacy_policy_contact_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি আমাদের সঙ্গে যোগাযোগ করলে, আপনার বার্তার উত্তর দিতে পারার জন্য কেবল সেই তথ্যই আমরা পাই যা আপনি নিজে জানাতে চান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du uns schreibst, erhalten wir die Informationen, die du selbst mitteilst, damit wir auf dein Anliegen antworten können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you contact us, we receive the information you choose to include so that we can respond to your request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si nos escribes, recibimos la información que decidas incluir para poder responder a tu solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si vous nous écrivez, nous recevons les informations que vous choisissez d'inclure, afin de pouvoir répondre à votre demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यदि आप हमसे संपर्क करते हैं, तो हमें केवल वही जानकारी मिलती है जो आप स्वयं भेजना चुनते हैं, ताकि हम आपके संदेश का उत्तर दे सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se ci scrivi, riceviamo le informazioni che scegli di includere, così da poter rispondere alla tua richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "お問い合わせいただいた場合、ご返信のために、お客様が記載を選んだ情報のみを受け取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "문의를 보내시면, 답변을 드리기 위해 보내 주신 내용만을 전달받습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeśli napiszesz do nas, otrzymujemy informacje, które sam zdecydujesz się przekazać, abyśmy mogli odpowiedzieć na Twoją wiadomość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se você entrar em contato conosco, recebemos as informações que decidir incluir, para que possamos responder à sua solicitação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы свяжетесь с нами, мы получим информацию, которую вы решите включить, чтобы ответить на ваш запрос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bize yazdığında, talebine yanıt verebilmemiz için paylaşmayı seçtiğin bilgileri alırız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви зв’яжетеся з нами, ми отримаємо інформацію, яку ви вирішите додати, щоб відповісти на ваш запит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如果你与我们联系，我们会收到你选择提供的信息，以便回复你的请求。"
          }
        }
      }
    },
