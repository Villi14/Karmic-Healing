    "onboarding_app_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বইয়ের শিক্ষাকে নিয়মিত সাধনায় রূপ দিন। নিজের নিরাময়ের পথ লিখে রাখুন, প্রার্থনা সাজিয়ে রাখুন এবং কর্মের অধিপতিগণের সঙ্গে ধাপে ধাপে কাজ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mach aus den Lehren des Buches eine regelmäßige Praxis. Verfolge deinen Heilungsweg, verwalte deine Bitten und arbeite Schritt für Schritt mit den Herren des Karma."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transform the teachings from the book into regular practice. Track your healing journey, manage requests, and work with the Lords of Karma step by step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Convierte las enseñanzas del libro en una práctica regular. Sigue tu camino de sanación, gestiona tus peticiones y trabaja paso a paso con los Señores del Karma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Transformez les enseignements du livre en pratique régulière. Suivez votre chemin de guérison, gérez vos demandes et travaillez pas à pas avec les Seigneurs du Karma."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पुस्तक की शिक्षाओं को नियमित अभ्यास में बदलें। अपनी उपचार यात्रा दर्ज करें, प्रार्थनाएँ संभालें और कर्म के स्वामियों के साथ चरण-दर-चरण कार्य करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trasforma gli insegnamenti del libro in una pratica regolare. Segui il tuo percorso di guarigione, gestisci le richieste e lavora passo dopo passo con i Signori del Karma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本の教えを日々の実践に変えましょう。癒やしの歩みを記録し、願いを整理し、カルマの主たちと一歩ずつ向き合えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "책의 가르침을 꾸준한 수행으로 바꾸세요. 치유의 여정을 기록하고, 청원을 정리하며, 카르마의 주인들과 한 걸음씩 함께합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zamień nauki z książki w regularną praktykę. Śledź swoją drogę uzdrawiania, zarządzaj prośbami i pracuj z Władcami Karmy krok po kroku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Transforme os ensinamentos do livro em prática regular. Acompanhe sua jornada de cura, organize seus pedidos e trabalhe passo a passo com os Senhores do Karma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превратите учения из книги в регулярную практику. Отслеживайте свой путь исцеления, управляйте просьбами и работайте с Властителями Кармы пошагово."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kitaptaki öğretileri düzenli bir pratiğe dönüştür. Şifa yolculuğunu takip et, dileklerini düzenle ve Karma Efendileri ile adım adım çalış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетворіть вчення з книги на регулярну практику. Відстежуйте свій шлях зцілення, керуйте проханнями та працюйте з Володарями Карми покроково."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "把书中的教导变成日常练习。记录你的疗愈历程，管理祈请，并一步步与业力之主一同工作。"
          }
        }
      }
    },
