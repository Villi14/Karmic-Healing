    "onboarding_journey_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কর্মের অধিপতিগণের সহায়তায় নিজের অতীত, বর্তমান ও ভবিষ্যৎ বদলে দিন। আধ্যাত্মিক নিরাময় ও আত্মরূপান্তরের যাত্রা আজই শুরু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verändere deine Vergangenheit, Gegenwart und Zukunft mit Hilfe der Herren des Karma. Beginne heute deinen Weg der spirituellen Heilung und persönlichen Wandlung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change your past, present, and future with the help of the Lords of Karma. Start your journey of spiritual healing and personal transformation today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cambia tu pasado, tu presente y tu futuro con la ayuda de los Señores del Karma. Comienza hoy tu camino de sanación espiritual y transformación personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Changez votre passé, votre présent et votre avenir avec l'aide des Seigneurs du Karma. Commencez dès aujourd'hui votre chemin de guérison spirituelle et de transformation personnelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कर्म के स्वामियों की सहायता से अपना अतीत, वर्तमान और भविष्य बदलें। आध्यात्मिक उपचार और आत्म-परिवर्तन की अपनी यात्रा आज ही आरंभ करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cambia il tuo passato, il tuo presente e il tuo futuro con l'aiuto dei Signori del Karma. Inizia oggi il tuo percorso di guarigione spirituale e trasformazione personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "カルマの主たちの助けを借りて、過去・現在・未来を変えていきましょう。精神的な癒やしと自己変容の旅を、今日から始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "카르마의 주인들의 도움으로 과거와 현재, 미래를 바꾸세요. 영적 치유와 개인적 변화의 여정을 오늘 시작하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmień swoją przeszłość, teraźniejszość i przyszłość z pomocą Władców Karmy. Rozpocznij dziś swoją drogę duchowego uzdrawiania i osobistej przemiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mude seu passado, presente e futuro com a ajuda dos Senhores do Karma. Comece hoje sua jornada de cura espiritual e transformação pessoal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измените свое прошлое, настоящее и будущее с помощью Властителей Кармы. Начните свой путь духовного исцеления и личностной трансформации уже сегодня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karma Efendileri'nin yardımıyla geçmişini, bugününü ve geleceğini değiştir. Ruhsal şifa ve kişisel dönüşüm yolculuğuna bugün başla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть своє минуле, теперішнє та майбутнє з допомогою Володарів Карми. Почніть свій шлях духовного зцілення та особистісного перетворення вже сьогодні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在业力之主的帮助下改变你的过去、现在与未来。今天就开启你的心灵疗愈与自我转化之旅。"
          }
        }
      }
    },
