    "help_tip_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ধৈর্য ধরুন — উত্তর সঙ্গে সঙ্গে না-ও আসতে পারে, কিন্তু সঠিক সময়ে ঠিকই আসবে"
