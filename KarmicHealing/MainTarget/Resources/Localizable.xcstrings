    "reminders_empty_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অনুস্মারক থাকে বিষয়ের ভিতরে। একটি বিষয় তৈরি করুন, ছোট ছোট অনুস্মারক সাধনাকে একটি নিয়মিত অভ্যাসে বদলে দেবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erinnerungen leben in Themen. Erstelle eines, und kleine Erinnerungen machen aus der Praxis ein festes Ritual."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders live in topics. Create one, and small reminders will turn the practice into a steady ritual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los recordatorios viven dentro de temas. Crea uno y los pequeños recordatorios convertirán la práctica en un ritual constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels vivent dans des thèmes. Créez-en un, et de petits rappels transformeront la pratique en un rituel régulier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अनुस्मारक विषयों के भीतर रहते हैं। एक विषय बनाइए, और छोटे-छोटे अनुस्मारक अभ्यास को एक स्थिर नित्यकर्म में बदल देंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I promemoria vivono dentro i temi. Creane uno e piccoli promemoria trasformeranno la pratica in un rituale costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リマインダーはテーマの中にあります。ひとつ作れば、小さなリマインダーが実践を確かな習慣に変えてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "미리 알림은 주제 안에 담깁니다. 하나를 만들면 작은 알림들이 수행을 꾸준한 의식으로 바꿔 줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienia żyją w tematach. Utwórz jeden, a drobne przypomnienia zamienią praktykę w stały rytuał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os lembretes vivem dentro de temas. Crie um, e pequenos lembretes vão transformar a prática em um ritual constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания живут в темах. Создайте первую — и небольшие напоминания превратят практику в устойчивый ритуал."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hatırlatıcılar konuların içinde yaşar. Bir konu oluştur; küçük hatırlatıcılar pratiği kalıcı bir ritüele dönüştürsün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагадування живуть у темах. Створіть першу — і невеликі нагадування перетворять практику на сталий ритуал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "提醒存放在主题之中。创建一个主题，小小的提醒会让练习成为稳定的仪式。"
          }
        }
      }
    },
