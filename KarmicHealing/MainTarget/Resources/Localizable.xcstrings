    "onboarding_book_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই অ্যাপটি 'Karmic Healing'-এর রুশ সংস্করণের পরিপূরক, যা ডায়ানা স্টাইনের ইংরেজি বই 'Psychic Healing with Spirit Guides and Angels'-এর অনুবাদ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese App ist eine Ergänzung zur russischen Ausgabe von „Karmic Healing“, einer Übersetzung der englischen Ausgabe „Psychic Healing with Spirit Guides and Angels“ von Diana Stein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is a supplement to the Russian edition 'Karmic Healing', which is a translation of the English edition 'Psychic Healing with Spirit Guides and Angels' by Diana Stein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta app es un complemento de la edición rusa de 'Karmic Healing', que es una traducción de la edición inglesa 'Psychic Healing with Spirit Guides and Angels' de Diana Stein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette app est un complément à l'édition russe de « Karmic Healing », traduction de l'édition anglaise « Psychic Healing with Spirit Guides and Angels » de Diana Stein."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह ऐप 'Karmic Healing' के रूसी संस्करण का पूरक है, जो डायना स्टाइन की अंग्रेज़ी पुस्तक 'Psychic Healing with Spirit Guides and Angels' का अनुवाद है।"
