        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने उच्च स्व से अपने पास आने की प्रार्थना करें, और फिर:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiedi al tuo Sé Superiore di venire da te, e poi:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ハイヤーセルフに来てもらうよう願い、それから："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "상위 자아에게 당신에게 와 달라고 청한 뒤:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poproś swoją Wyższą Jaźń, aby przyszła do Ciebie, a następnie:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
