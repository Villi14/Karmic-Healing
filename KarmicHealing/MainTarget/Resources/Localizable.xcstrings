    "attention_before_proceeding" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete the previous step before moving on to the next one. Each step takes about five minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем перейти к следующему этапу, полностью завершите предыдущий. Каждый этап занимает около пяти минут."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершіть попередній крок перед тим, як перейти до наступного. Кожен крок займає близько п'яти хвилин."
          }
        }
      }
    },
