          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alanını hazırla"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підготуйте простір"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
