    "karma_step_5" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "উত্তর যদি \"না\" হয়, তবে জিজ্ঞাসা করুন মুক্তি পেতে আপনাকে কী করতে হবে। উত্তরের অপেক্ষা করুন। পূর্বজন্মের এমন কোনো তথ্য পেলে যা পুরোপুরি বোঝেন না, ব্যাখ্যা চেয়ে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn die Antwort „nein“ lautet, frage, was du tun sollst, um die Befreiung zu erlangen. Warte auf die Antwort. Erhältst du Informationen über ein früheres Leben, die du nicht ganz verstehst, bitte um Klärung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the answer is \"no\", ask what you should do to achieve liberation. Wait for the answer. If you receive information about a past life that you don't fully understand, ask for clarification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si la respuesta es \"no\", pregunta qué debes hacer para alcanzar la liberación. Espera la respuesta. Si recibes información sobre una vida pasada que no comprendes del todo, pide una aclaración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si la réponse est « non », demandez ce que vous devez faire pour obtenir la libération. Attendez la réponse. Si vous recevez des informations sur une vie passée que vous ne comprenez pas entièrement, demandez des précisions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यदि उत्तर \"नहीं\" है, तो पूछें कि मुक्ति पाने के लिए आपको क्या करना चाहिए। उत्तर की प्रतीक्षा करें। यदि पिछले जन्म की ऐसी जानकारी मिले जो आप पूरी तरह न समझ पाएँ, तो स्पष्टीकरण माँगें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se la risposta è \"no\", chiedi che cosa devi fare per ottenere la liberazione. Attendi la risposta. Se ricevi informazioni su una vita passata che non comprendi del tutto, chiedi chiarimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "答えが「いいえ」なら、解放に至るために何をすべきかを尋ねます。答えを待ちましょう。よく理解できない過去生の情報を受け取った場合は、さらに説明を求めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "답이 \"아니오\"라면, 해방에 이르기 위해 무엇을 해야 하는지 물으세요. 답을 기다립니다. 온전히 이해되지 않는 전생의 정보를 받았다면 설명을 더 청하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeśli odpowiedź brzmi „nie”, zapytaj, co masz zrobić, aby osiągnąć uwolnienie. Poczekaj na odpowiedź. Jeśli otrzymasz informacje o poprzednim życiu, których nie do końca rozumiesz, poproś o wyjaśnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se a resposta for \"não\", pergunte o que você deve fazer para alcançar a libertação. Aguarde a resposta. Se receber informações sobre uma vida passada que não compreende totalmente, peça esclarecimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если же ответ \"нет\", спросите, что вам следует сделать, чтобы добиться освобождения. Подождите, пока придет ответ. Если вам дадут информацию о прошлой жизни, которую вы понимаете не до конца, попросите прояснить то, что вы увидели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yanıt \"hayır\" ise özgürleşmeye ulaşmak için ne yapman gerektiğini sor. Yanıtı bekle. Tam olarak anlamadığın bir geçmiş yaşam bilgisi alırsan açıklama iste."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ж відповідь \"ні\", запитайте, що вам слід зробити, щоб досягти звільнення. Дочекайтеся, поки прийде відповідь. Якщо вам дадуть інформацію про минуле життя, яку ви розумієте не до кінця, попросіть прояснити те, що ви побачили."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如果回答是“否”，就询问你需要做什么才能获得解脱。等待回答。如果收到关于前世的信息而你并不完全理解，请求进一步说明。"
          }
        }
      }
    },
