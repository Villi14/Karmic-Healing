          }
        }
      }
    },
    "privacy_policy_intro_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmic Healing works on iPhone, iPad, and Apple Watch and is designed to work offline. We do not operate servers that collect, store, or process your personal information."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmic Healing работает на iPhone, iPad и Apple Watch и предназначено для работы в автономном режиме. Мы не управляем серверами, которые собирают, хранят или обрабатывают вашу личную информацию."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmic Healing працює на iPhone, iPad і Apple Watch та розроблений для роботи офлайн. Ми не керуємо серверами, які збирають, зберігають або обробляють вашу особисту інформацію."
          }
        }
      }
    },
