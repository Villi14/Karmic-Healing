        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "꾸준히 수행하세요 — 자주 소통할수록 연결은 더 강해집니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Praktykuj regularnie — im częściej się komunikujesz, tym silniejsza staje się więź"
