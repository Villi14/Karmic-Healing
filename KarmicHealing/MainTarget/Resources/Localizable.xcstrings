    "part_1_step_10_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a) ask his name;\nb) ask him for a gift;\nc) listen to his request for a return gift;\nd) ask that it remain with you always."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) спросите его имя;\nb) попросите его о даре;\nc) выслушайте его просьбу об ответном даре;\nd) попросите, чтобы оно оставалось с вами всегда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "а) запитайте його ім'я;\nb) попросіть його про дар;\nc) вислухайте його прохання про відповідний дар;\nd) попросіть, щоб це залишалося з вами завжди."
          }
        }
      }
    },
