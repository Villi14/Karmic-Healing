        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नियमित अभ्यास करें — जितना अधिक संवाद करेंगे, संबंध उतना ही प्रगाढ़ होगा"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratica con regolarità: più comunichi, più il tuo legame si rafforza"
