        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "과정을 신뢰하세요 — 즉각적인 결과가 보이지 않아도 치유는 일어나고 있습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
