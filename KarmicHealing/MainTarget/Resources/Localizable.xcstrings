    "help_step_4_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রার্থনা জানানোর পর নীরব ও সজাগ থাকুন। পথনির্দেশ আসতে পারে ভাবনা, অনুভূতি, চিত্র কিংবা ভিতরের এক নিশ্চিত জানার মধ্য দিয়ে। নিজের অন্তর্দৃষ্টিকে বিশ্বাস করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bleibe nach deiner Bitte still und aufmerksam. Führung kann über Gedanken, Gefühle, Bilder oder inneres Wissen kommen. Vertraue deiner Intuition."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After making your request, remain quiet and attentive. You may receive guidance through thoughts, feelings, images, or inner knowing. Trust your intuition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Después de formular tu petición, permanece en silencio y atento. Puedes recibir guía a través de pensamientos, sensaciones, imágenes o una certeza interior. Confía en tu intuición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après avoir formulé votre demande, restez silencieux et attentif. La guidance peut venir par des pensées, des sensations, des images ou une certitude intérieure. Faites confiance à votre intuition."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रार्थना कहने के बाद मौन और सजग रहें। मार्गदर्शन विचारों, भावनाओं, चित्रों या भीतर के बोध के रूप में आ सकता है। अपने अंतर्ज्ञान पर भरोसा रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo aver formulato la richiesta, resta in silenzio e attento. La guida può arrivare attraverso pensieri, sensazioni, immagini o una certezza interiore. Fidati della tua intuizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "願いを伝えたあとは、静かに、注意深くいてください。導きは思考、感情、映像、あるいは内なる確信として届くことがあります。直感を信頼しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "청원을 전한 뒤에는 고요하고 깨어 있는 상태를 유지하세요. 인도는 생각, 감정, 이미지 또는 내면의 앎으로 찾아올 수 있습니다. 직관을 믿으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po wypowiedzeniu prośby pozostań w ciszy i uważności. Prowadzenie może przyjść przez myśli, uczucia, obrazy lub wewnętrzne poczucie wiedzy. Zaufaj swojej intuicji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de fazer o pedido, permaneça em silêncio e atento. Você pode receber orientação por meio de pensamentos, sensações, imagens ou um saber interior. Confie na sua intuição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После изложения просьбы оставайтесь тихими и внимательными. Вы можете получить руководство через мысли, чувства, образы или внутреннее знание. Доверяйте своей интуиции."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dileğini ilettikten sonra sessiz ve dikkatli kal. Yönlendirme düşünceler, duygular, imgeler ya da içsel bir bilme yoluyla gelebilir. Sezgine güven."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після викладення прохання залишайтеся тихими та уважними. Ви можете отримати керівництво через думки, почуття, образи або внутрішнє знання. Довіряйте своїй інтуїції."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "说出祈请后，保持安静与专注。指引可能通过念头、感受、影像或内在的了知到来。相信你的直觉。"
          }
        }
      }
    },
    "help_step_4_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
