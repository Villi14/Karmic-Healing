    "privacy_policy_data_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যাপটির জন্য কোনো অ্যাকাউন্ট লাগে না এবং এটি আপনার অনুস্মারক, প্রার্থনা, নোট বা অ্যাপের কার্যকলাপ আমাদের কাছে পাঠায় না। আপনার দেওয়া তথ্য অ্যাপ চালানোর জন্য আপনার ডিভাইসেই থাকে। আমরা অ্যানালিটিক্স, বিজ্ঞাপন শনাক্তকারী বা ব্যবহার-ট্র্যাকিং পরিষেবা ব্যবহার করি না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App benötigt kein Konto und sendet uns weder deine Erinnerungen, Bitten und Notizen noch deine Aktivität in der App. Die von dir eingegebenen Informationen bleiben für den Betrieb der App auf deinem Gerät. Wir verwenden keine Analysedienste, Werbe-IDs oder Nutzungs-Tracking."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does not require an account and does not send your reminders, requests, notes, or app activity to us. Information you enter is kept on your device for the app to function. We do not use analytics, advertising identifiers, or usage-tracking services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La app no requiere cuenta y no nos envía tus recordatorios, peticiones, notas ni tu actividad en la app. La información que introduces se guarda en tu dispositivo para que la app funcione. No usamos analíticas, identificadores publicitarios ni servicios de seguimiento de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'app ne nécessite pas de compte et ne nous transmet ni vos rappels, ni vos demandes, ni vos notes, ni votre activité dans l'app. Les informations que vous saisissez restent sur votre appareil pour le fonctionnement de l'app. Nous n'utilisons ni outils d'analyse, ni identifiants publicitaires, ni services de suivi d'utilisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐप के लिए किसी खाते की आवश्यकता नहीं है और यह आपके अनुस्मारक, प्रार्थनाएँ, टिप्पणियाँ या ऐप की गतिविधि हमें नहीं भेजता। आपकी दर्ज की गई जानकारी ऐप के संचालन के लिए आपके डिवाइस पर ही रहती है। हम एनालिटिक्स, विज्ञापन पहचानकर्ता या उपयोग-ट्रैकिंग सेवाओं का उपयोग नहीं करते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'app non richiede un account e non ci invia i tuoi promemoria, le tue richieste, le tue note né la tua attività nell'app. Le informazioni che inserisci restano sul tuo dispositivo per il funzionamento dell'app. Non usiamo strumenti di analisi, identificatori pubblicitari o servizi di tracciamento dell'utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本アプリはアカウントを必要とせず、リマインダー、願い、メモ、アプリ内の操作履歴を当方に送信することはありません。入力された情報は、アプリの動作のためにお使いのデバイス内に保存されます。解析ツール、広告識別子、利用状況の追跡サービスは使用していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 앱은 계정이 필요 없으며, 미리 알림·청원·메모·앱 사용 기록을 저희에게 보내지 않습니다. 입력한 정보는 앱 동작을 위해 기기에 보관됩니다. 분석 도구, 광고 식별자, 사용 추적 서비스는 사용하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacja nie wymaga konta i nie przesyła nam Twoich przypomnień, próśb, notatek ani aktywności w aplikacji. Wprowadzone informacje pozostają na Twoim urządzeniu, aby aplikacja mogła działać. Nie używamy analityki, identyfikatorów reklamowych ani usług śledzenia użytkowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O app não exige conta e não nos envia seus lembretes, pedidos, notas ou atividade no app. As informações que você insere ficam no seu dispositivo para o funcionamento do app. Não usamos análises, identificadores de publicidade ou serviços de rastreamento de uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению не требуется учетная запись, и оно не отправляет нам ваши напоминания, просьбы, заметки или данные об использовании. Введенная вами информация хранится на вашем устройстве для работы приложения. Мы не используем аналитику, рекламные идентификаторы или сервисы отслеживания использования."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uygulama hesap gerektirmez; hatırlatıcılarını, dileklerini, notlarını veya uygulama içindeki etkinliğini bize göndermez. Girdiğin bilgiler, uygulamanın çalışması için cihazında tutulur. Analitik araçlar, reklam tanımlayıcıları veya kullanım izleme hizmetleri kullanmıyoruz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок не потребує облікового запису та не надсилає нам ваші нагадування, прохання, нотатки чи дані про використання. Введена вами інформація зберігається на пристрої, щоб застосунок міг працювати. Ми не використовуємо аналітику, рекламні ідентифікатори або сервіси відстеження використання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本应用无需账户，也不会把你的提醒、祈请、备注或使用行为发送给我们。你输入的信息保存在设备上，仅用于应用运行。我们不使用分析工具、广告标识符或使用情况追踪服务。"
          }
        }
      }
    },
