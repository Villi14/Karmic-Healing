            "value" : "अपना अभ्यास जारी रखने के लिए Face ID, Touch ID या अपने डिवाइस का पासकोड उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa Face ID, Touch ID o il codice del dispositivo per continuare la tua pratica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Face ID、Touch ID、またはデバイスのパスコードで実践を続けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Face ID, Touch ID 또는 기기 암호로 수행을 이어가세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj Face ID, Touch ID lub kodu urządzenia, aby kontynuować praktykę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use o Face ID, o Touch ID ou o código do seu dispositivo para continuar sua prática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Face ID, Touch ID или код-пароль устройства, чтобы продолжить практику."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratiğine devam etmek için Face ID, Touch ID ya da cihaz parolanı kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використайте Face ID, Touch ID або код-пароль пристрою, щоб продовжити практику."
          }
