    "thanks_for_using_karmic_healing_2025" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is a supplement to the Russian edition 'Karmic Healing', which is a translation of the English edition 'Psychic Healing with Spirit Guides and Angels' by Diana Stein.\n\nDevelopment:\n• Built with TCA (The Composable Architecture)\n\nThanks for using Karmic Healing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приложение является дополнением к российскому изданию 'Кармическое Исцеление', которое является переводом английского издания 'Psychic Healing with Spirit Guides and Angels' Дайаны Стайн.\n\nРазработка:\n• Создано с использованием TCA (The Composable Architecture)\n\nСпасибо за использование Karmic Healing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей застосунок є доповненням до російського видання 'Кармическое Исцеление', яке є перекладом англійського видання 'Psychic Healing with Spirit Guides and Angels' Дайани Стайн.\n\nРозробка:\n• Створено з використанням TCA (The Composable Architecture)\n\nДякуємо за використання Karmic Healing."
          }
        }
      }
