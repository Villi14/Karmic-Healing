    "karma_step_9" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই সত্তাগুলির প্রতি গভীর শ্রদ্ধা রাখুন। কখনও তাঁদের সঙ্গে তর্ক করবেন না এবং ধন্যবাদ জানাতে ভুলবেন না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Begegne diesen Wesen mit großem Respekt. Streite nie mit ihnen und vergiss nicht, dich zu bedanken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat these Beings with great respect. Never argue with them and don't forget to thank them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trata a estos Seres con gran respeto. Nunca discutas con ellos y no olvides darles las gracias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traitez ces Êtres avec un grand respect. Ne discutez jamais avec eux et n'oubliez pas de les remercier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इन सत्ताओं के प्रति गहरा आदर रखें। उनसे कभी विवाद न करें और धन्यवाद देना न भूलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tratta questi Esseri con grande rispetto. Non discutere mai con loro e non dimenticare di ringraziarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これらの存在に深い敬意をもって接してください。決して言い争わず、感謝を伝えることを忘れないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 존재들을 깊이 존중하며 대하세요. 결코 다투지 말고, 감사 인사를 잊지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traktuj te Istoty z wielkim szacunkiem. Nigdy się z nimi nie spieraj i nie zapomnij podziękować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trate esses Seres com grande respeito. Nunca discuta com eles e não se esqueça de agradecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Относитесь к этим Существам с огромным почтением. Никогда не спорьте с ними и не забывайте благодарить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
