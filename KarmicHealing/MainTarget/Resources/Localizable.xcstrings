    "home_daily_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কয়েকটি শান্ত মিনিট নিন, শক্তির ভারসাম্য ফিরিয়ে আনুন এবং সাধনা চালিয়ে যান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimm dir ein paar ruhige Minuten, um deine Energie auszugleichen und deine Praxis fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a few quiet minutes to balance your energy and continue your practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dedica unos minutos de calma a equilibrar tu energía y continuar tu práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accordez-vous quelques minutes de calme pour équilibrer votre énergie et poursuivre votre pratique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुछ शांत मिनट निकालें, अपनी ऊर्जा संतुलित करें और अभ्यास जारी रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dedica qualche minuto di calma a riequilibrare la tua energia e a continuare la pratica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "静かな数分を取って、エネルギーを整え、実践を続けましょう。"
