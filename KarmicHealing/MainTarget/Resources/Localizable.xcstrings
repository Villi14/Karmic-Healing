    "requests_structure_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একটি প্রার্থনাকে উপ-প্রার্থনায় ভাগ করা যায়। কোনো উপ-প্রার্থনা পূর্ণ না হওয়া পর্যন্ত প্রার্থনাটি বন্ধ থাকে — সব শেষ হলে আপনি নিজেই সেটি চিহ্নিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Bitte lässt sich in Teilbitten aufteilen. Solange eine Teilbitte offen ist, bleibt die Bitte gesperrt – markiere sie selbst, sobald alle erfüllt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A request can be broken into subrequests. While any subrequest is unfulfilled, the request itself stays locked — mark it yourself once they are all done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una petición puede dividirse en subpeticiones. Mientras quede alguna subpetición sin cumplir, la petición permanece bloqueada; márcala tú mismo cuando estén todas hechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une demande peut être divisée en sous-demandes. Tant qu'une sous-demande n'est pas accomplie, la demande reste verrouillée — cochez-la vous-même une fois qu'elles sont toutes terminées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक प्रार्थना को उप-प्रार्थनाओं में बाँटा जा सकता है। जब तक कोई उप-प्रार्थना अधूरी है, प्रार्थना बंद रहती है — सब पूरी होने पर आप स्वयं उसे चिह्नित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una richiesta può essere suddivisa in sottorichieste. Finché una sottorichiesta non è esaudita, la richiesta resta bloccata: contrassegnala tu stesso quando sono tutte completate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ひとつの願いは、小さな願いに分けられます。小さな願いがひとつでも未達なら、その願いはロックされたままです——すべて終えたら、ご自身で印を付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "하나의 청원은 하위 청원으로 나눌 수 있습니다. 하위 청원이 하나라도 남아 있으면 청원은 잠긴 상태로 유지됩니다 — 모두 마치면 직접 표시해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prośbę można podzielić na podprośby. Dopóki którakolwiek podprośba nie jest spełniona, prośba pozostaje zablokowana — oznacz ją samodzielnie, gdy wszystkie będą gotowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um pedido pode ser dividido em subpedidos. Enquanto houver algum subpedido não cumprido, o pedido continua bloqueado — marque você mesmo quando todos estiverem concluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просьбу можно разбить на подпросьбы. Пока хоть одна подпросьба не выполнена, сама просьба остаётся закрытой — отметьте её сами, когда все они будут выполнены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir dilek alt dileklere bölünebilir. Herhangi bir alt dilek yerine gelmediği sürece dilek kilitli kalır — hepsi tamamlandığında işareti sen koy."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прохання можна розбити на підпрохання. Поки хоч одне підпрохання не виконане, саме прохання лишається заблокованим — відмітьте його самі, коли всі вони будуть виконані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一个祈请可以拆分为子祈请。只要还有子祈请未实现，该祈请就保持锁定——全部完成后由你自己标记。"
          }
        }
      }
    },
