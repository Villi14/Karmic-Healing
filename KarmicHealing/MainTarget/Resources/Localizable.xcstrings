    "help_tip_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রক্রিয়াটিকে বিশ্বাস করুন — তাৎক্ষণিক ফল না দেখলেও নিরাময় ঘটে চলেছে"
