    "part_1_step_10" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার উচ্চতর সত্তাকে আপনার কাছে আসতে বলুন, তারপর:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitte dein Höheres Selbst, zu dir zu kommen, und dann:"
